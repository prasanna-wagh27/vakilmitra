# Settings for deploy/compose.yml. Copy to deploy/.env on the server (chmod 600) and fill in.
# Generate random values with: openssl rand -base64 48

# ---- Addresses ----
# The site is https://DOMAIN, the admin panel https://admin.DOMAIN. Point DOMAIN, www.DOMAIN and
# admin.DOMAIN at the server (DNS A records) before the first start, so HTTPS certificates can be issued.
DOMAIN=
# Let's Encrypt writes here about certificate problems.
ACME_EMAIL=

# ---- Images ----
# IMAGE_TAG is set by the deploy pipeline (the commit sha); "latest" is the newest main.
IMAGE_TAG=latest
# IMAGE_REPO=ghcr.io/prasanna-wagh27/vakilmitra

# ---- Secrets ----
POSTGRES_PASSWORD=
# At least 32 characters.
BETTER_AUTH_SECRET=
# Encryption keys for client files. Keep an offline copy: without it, files and backups cannot be read.
# Generate: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
STORAGE_MASTER_KEYS=

# ---- Client files: S3 bucket in Mumbai (ap-south-1) ----
STORAGE_DRIVER=s3
S3_BUCKET=
S3_REGION=ap-south-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# For an S3-compatible provider other than AWS: S3_ENDPOINT=https://...  S3_FORCE_PATH_STYLE=true
# Or keep files on the server's disk (a Docker volume): STORAGE_DRIVER=fs

# ---- Nightly backups at 03:00 IST: a different bucket, ideally in another account ----
BACKUP_STORAGE_DRIVER=s3
BACKUP_S3_BUCKET=
BACKUP_S3_REGION=ap-south-1
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=

# ---- Email (password resets, receipts) ----
# e.g. smtps://USER:PASS@email-smtp.ap-south-1.amazonaws.com:465
SMTP_URL=
MAIL_FROM="VakilMitra <no-reply@DOMAIN>"

# ---- Payments (optional until live) ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_SOLO=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_CHAMBER=
BILLING_SUPPLIER_NAME=Outgrid Labs
BILLING_SUPPLIER_ADDRESS=

# ---- Error reports (optional): a Sentry project DSN for the API and worker ----
# The browser DSN is set at build time instead (VITE_SENTRY_DSN in the deploy pipeline).
SENTRY_DSN=
SENTRY_ENVIRONMENT=production
# Share of requests traced for performance (0 to 1); 0 sends errors only.
SENTRY_TRACES_SAMPLE_RATE=0

# ---- OCR ----
OCR_CONCURRENCY=2
# Cloud reading for hard pages, only for advocates who turn it on: none, sarvam or gemini.
OCR_CLOUD_ENGINE=none
# SARVAM_API_KEY=
