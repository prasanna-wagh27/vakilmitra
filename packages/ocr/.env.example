# Cloud OCR engines (used by the eval harness and, with the advocate's consent, by the worker).
# Leave unset to run Tesseract only.
SARVAM_API_KEY=
# Gemini on Vertex AI in Mumbai (paid terms, data stays in India). Auth: Google Application Default Credentials.
GEMINI_PROVIDER=vertex
GOOGLE_VERTEX_PROJECT=
GOOGLE_VERTEX_LOCATION=asia-south1
GEMINI_MODEL=gemini-3.5-flash
# Only for evaluating on non-client pages: the consumer Gemini API's free tier may use inputs for training.
# GEMINI_PROVIDER=google
# GOOGLE_GENERATIVE_AI_API_KEY=
