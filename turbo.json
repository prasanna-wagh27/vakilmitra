{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": { "dependsOn": ["^build"], "outputs": ["dist/**"], "env": ["SITE_URL"] },
    "typecheck": { "dependsOn": ["^build"] },
    "test": { "dependsOn": ["^build"], "env": ["TEST_DATABASE_URL"], "passThroughEnv": ["PG_BIN_DIR"] },
    "dev": { "dependsOn": ["^build"], "cache": false, "persistent": true }
  }
}
