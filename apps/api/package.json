{
  "name": "@vakilmitra/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import ./dist/instrument.js dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "tsx --env-file-if-exists=.env src/seed.ts",
    "billing:plans": "tsx --env-file-if-exists=.env src/scripts/billing-plans.ts",
    "admin:staff": "tsx --env-file-if-exists=.env src/scripts/admin-staff.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.4.3",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/swagger": "^9.9.5",
    "@sentry/node": "10.78.0",
    "@vakilmitra/ai": "workspace:*",
    "@vakilmitra/db": "workspace:*",
    "@vakilmitra/jobs": "workspace:*",
    "@vakilmitra/shared": "workspace:*",
    "@vakilmitra/storage": "workspace:*",
    "better-auth": "1.7.25",
    "bullmq": "^6.7.6",
    "date-fns": "^4.4.0",
    "docx": "9.15.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "ioredis": "^5.11.1",
    "nodemailer": "10.3.1",
    "sharp": "~0.35.5",
    "zod": "4"
  },
  "devDependencies": {
    "@fastify/swagger-ui": "^6.1.4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/supertest": "^7.2.1",
    "ai": "^7.0.173",
    "jszip": "3.10.2",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.2",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  }
}
