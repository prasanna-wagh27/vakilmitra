DATABASE_URL=postgresql://vakilmitra:vakilmitra@localhost:5432/vakilmitra
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars
API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
PORT=4000
VALKEY_URL=redis://localhost:6379
STORAGE_DRIVER=fs
STORAGE_DIR=./.data/blobs
# Generate: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
STORAGE_MASTER_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
# Razorpay (optional; without it, online payment is off). Test keys start with rzp_test_.
# Webhook URL: <API_URL>/api/webhooks/razorpay, events: payment.captured, subscription.charged,
# subscription.halted, subscription.pending, subscription.cancelled, subscription.completed, refund.processed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Monthly plan ids; create them with: pnpm --filter @vakilmitra/api billing:plans
RAZORPAY_PLAN_SOLO=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_CHAMBER=

# Outgoing email (password resets, receipts). Any SMTP provider; empty prints emails to the log in dev.
SMTP_URL=
MAIL_FROM="VakilMitra <no-reply@vakilmitra.in>"
