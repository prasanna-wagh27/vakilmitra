DATABASE_URL=postgresql://vakilmitra:vakilmitra@localhost:5432/vakilmitra
BETTER_AUTH_SECRET=change-me-to-a-long-random-string-of-32-chars
API_URL=http://localhost:4000
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5174
PORT=4000
VALKEY_URL=redis://localhost:6379
STORAGE_DRIVER=fs
STORAGE_DIR=./.data/blobs
# Generate: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
STORAGE_MASTER_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
# Razorpay (optional; without it, online payment is off). Test keys start with rzp_test_.
# Webhook URL: <API_URL>/api/webhooks/razorpay, events: payment.captured, subscription.charged,
# subscription.halted, subscription.pending, subscription.cancelled, subscription.completed, refund.processed
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Monthly plan ids; create them with: pnpm --filter @vakilmitra/api billing:plans
RAZORPAY_PLAN_SOLO=
RAZORPAY_PLAN_PRO=
RAZORPAY_PLAN_CHAMBER=
# Seller details on receipts. GSTIN and SAC only once GST_REGISTERED is true in packages/shared/src/billing.ts.
BILLING_SUPPLIER_NAME=Outgrid Labs
BILLING_SUPPLIER_ADDRESS=
BILLING_SUPPLIER_GSTIN=
BILLING_SAC=

# Outgoing email (password resets, receipts). Any SMTP provider; empty prints emails to the log in dev.
SMTP_URL=
MAIL_FROM="VakilMitra <no-reply@vakilmitra.in>"

# Error reports to Sentry (optional; nothing is sent without a DSN). Reports are scrubbed: no bodies,
# cookies, query strings or personal details.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# ---- AI models (drafting, translation) ----
# Each task names its model as <provider>:<model id>; several, comma-separated, are tried in order.
# Providers: anthropic, openai, google, vertex, vertex-anthropic, sarvam, compatible. A task with no model is off.
# AI_MODEL_DEFAULT=vertex:gemini-3.5-flash
# AI_MODEL_DRAFTING=anthropic:claude-sonnet-5-5
# AI_MODEL_TRANSLATION=sarvam:<model id>,vertex:gemini-3.5-flash
# Refuse (at start-up) any model that would process data outside India:
# AI_INDIA_ONLY=true
# Keys, only for the providers used:
# ANTHROPIC_API_KEY=  OPENAI_API_KEY=  GOOGLE_GENERATIVE_AI_API_KEY=  SARVAM_API_KEY=
# GOOGLE_VERTEX_PROJECT=  GOOGLE_VERTEX_LOCATION=asia-south1   (Vertex signs in with Google credentials)
# AI_COMPATIBLE_BASE_URL=  AI_COMPATIBLE_API_KEY=  AI_COMPATIBLE_IN_INDIA=false
