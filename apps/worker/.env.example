DATABASE_URL=postgresql://vakilmitra:vakilmitra@localhost:5432/vakilmitra
VALKEY_URL=redis://localhost:6379
STORAGE_DRIVER=fs
STORAGE_DIR=../api/.data/blobs
# Same keys as the API. Generate one: node -e "console.log('k1:'+require('crypto').randomBytes(32).toString('base64'))"
STORAGE_MASTER_KEYS=k1:REPLACE_WITH_BASE64_32_BYTES
OCR_CONCURRENCY=1
# Cloud OCR for hard pages, only for advocates who turned on cloud reading in Settings.
# OCR_CLOUD_ENGINE=none|sarvam|gemini   OCR_CLOUD_MODE=fallback|always   OCR_CLOUD_BELOW=0.85
# Parallel cloud reads (their own queue; mostly network wait): OCR_CLOUD_CONCURRENCY=4
OCR_CLOUD_ENGINE=none
# Keys for the chosen engine: see packages/ocr/.env.example
# Nightly backups at 03:00 IST (off until set). Use a different bucket, ideally another account:
# BACKUP_STORAGE_DRIVER=s3 BACKUP_S3_BUCKET BACKUP_S3_REGION BACKUP_S3_ENDPOINT? BACKUP_S3_ACCESS_KEY_ID BACKUP_S3_SECRET_ACCESS_KEY
# Local try-out: BACKUP_STORAGE_DRIVER=fs BACKUP_STORAGE_DIR=../api/.data/backups
# Scratch database the nightly restore check drops and recreates (name must end in _restore_check):
# BACKUP_RESTORE_CHECK_URL=postgresql://vakilmitra:vakilmitra@localhost:5432/vakilmitra_restore_check
# Error reports to Sentry for jobs that fail after their last retry (optional).
SENTRY_DSN=
# Case tracking on eCourts: demo gives made-up records for trying it locally (refused in production).
# For real records: COURTS_PROVIDER=ecourtsindia COURTS_API_KEY=...   Check one case: pnpm courts:check <CNR>
COURTS_PROVIDER=demo
# The evening email (7:30 pm IST): printed to the log without SMTP_URL.
# SMTP_URL=  MAIL_FROM="VakilMitra <no-reply@vakilmitra.in>"
WEB_ORIGIN=http://localhost:5173
