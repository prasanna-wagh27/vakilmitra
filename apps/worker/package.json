{
  "name": "@vakilmitra/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node --import ./dist/instrument.js dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "backup": "tsx --env-file-if-exists=.env src/backup-cli.ts",
    "courts:check": "tsx --env-file-if-exists=.env src/courts-cli.ts"
  },
  "dependencies": {
    "@sentry/node": "10.78.0",
    "@vakilmitra/courts": "workspace:*",
    "@vakilmitra/db": "workspace:*",
    "@vakilmitra/jobs": "workspace:*",
    "@vakilmitra/ocr": "workspace:*",
    "@vakilmitra/shared": "workspace:*",
    "@vakilmitra/storage": "workspace:*",
    "bullmq": "^6.7.6",
    "ioredis": "^5.11.1",
    "nodemailer": "10.3.1",
    "pg": "^8.23.1",
    "pino": "^9.14.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "^8.23.1",
    "pino-pretty": "^13.2.0",
    "tsx": "^4.23.15",
    "typescript": "5.9.3",
    "vitest": "^3.2.7"
  }
}
